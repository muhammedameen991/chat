{
  "rewrites": [
    {
      "source": "/api/signaling/:path*",
      "destination": "/api/signaling.js"
    },
    {
      "source": "/api/signaling",
      "destination": "/api/signaling.js"
    },
    {
      "source": "/api/users/:path*",
      "destination": "/api/users.js"
    },
    {
      "source": "/api/users",
      "destination": "/api/users.js"
    }
  ]
}
